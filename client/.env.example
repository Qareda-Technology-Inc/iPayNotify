# Vite dev proxy: where the Node API listens (must match server PORT, default 4000).
# If you see "http proxy error" / ECONNREFUSED, start the API (`npm run dev` from repo root or `npm run dev --prefix server`).
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Production (SPA on Vercel / static CDN, API on Render etc.): full URL to the API, no trailing slash.
# Required for login and all /api calls when the UI is not served from the same host as the server.
# Set this in Vercel → Project → Settings → Environment Variables, then redeploy.
# VITE_API_BASE_URL=https://your-service.onrender.com
#
# Vercel: use Root Directory "client" (or copy client/vercel.json) so SPA routes like /portal/renew
# rewrite to index.html. On Render set CLIENT_ORIGIN to your exact Vercel URL (https, no path).
