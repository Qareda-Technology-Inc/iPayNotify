PORT=4000
# Browser origin(s) allowed to call this API (CORS). Comma-separated if you use several front-end URLs.
# Use scheme + host only — no path, and avoid a trailing slash (https://app.vercel.app not https://app.vercel.app/).
# Add each Vercel preview URL you use, or set CORS_VERCEL_PREVIEW_HOST_SUFFIX below.
CLIENT_ORIGIN=http://localhost:5173
#
# Vercel previews use a different hostname per deploy (e.g. *-elprofessortechs-projects.vercel.app).
# Set this to the stable suffix so you do not have to update CLIENT_ORIGIN for every preview:
# CORS_VERCEL_PREVIEW_HOST_SUFFIX=elprofessortechs-projects.vercel.app
# Set TRUST_PROXY=1 when the API sits behind nginx/Cloudflare so customer WAN IP matching works
# TRUST_PROXY=1
MONGODB_URI=mongodb://127.0.0.1:27017/qarefi_billing

# After adding roles: `npm run db:backfill-admin-roles` (sets legacy admins to super_admin).

# Multi-tenant: after `npm run db:backfill-organization`, set this to the printed ObjectId so new API
# writes can default to your org (optional until routes enforce it).
# DEFAULT_ORGANIZATION_ID=65a1b2c3d4e5f67890123456
# Optional overrides for the backfill script (defaults: Qaretech Innovative / qaretech-innovative)
# ORG_BACKFILL_NAME=Qaretech Innovative
# ORG_BACKFILL_SLUG=qaretech-innovative

# Required in production — used to sign admin JWTs
JWT_SECRET=use-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin login: organisation admins (org_admin) get a 6-digit code by email (SMTP) and/or SMS after password.
# Super admins bypass verification and receive a JWT immediately. Set SMTP + Arkesel (or *_MOCK=true for local).
# ADMIN_LOGIN_VERIFY=false
# SMTP_HOST=smtp.example.com
# Port 587 → STARTTLS → SMTP_SECURE=false (default). Port 465 → implicit TLS → SMTP_SECURE=true.
# Wrong "tls_validate_record_header:wrong version number" almost always means SMTP_SECURE=true on 587.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="QareFi Billing <billing@example.com>"
# SMTP_MOCK=true
# HTML templates: sign-in OTP + test mail (super admin → Email & templates in the dashboard).
# Extra inbox(es) for payment-success alerts (comma-separated). Org admins are emailed too.
# PAYMENT_ADMIN_NOTIFY_EMAIL=ops@example.com,finance@example.com

# Main admin (only used if no admin exists yet). Change password in production.
# DEFAULT_ADMIN_EMAIL=qaredadev@gmail.com
# DEFAULT_ADMIN_PASSWORD=
# Optional Ghana phone for SMS login verification (ADMIN_LOGIN_VERIFY=true)
# DEFAULT_ADMIN_PHONE=0244123456
# Full name for the seeded super admin (optional; shown in UI and ticket SMS)
# DEFAULT_ADMIN_FULL_NAME=Platform Admin

# Single-router fallback in code (per-router records in the dashboard use their own host/port).
# RouterOS API default is 8728. Winbox is 8291 (different protocol — do not use 8291 for API).
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=

# Default profiles on the router (must exist on MikroTik)
MIKROTIK_DEFAULT_PPP_PROFILE=default
MIKROTIK_EXPIRED_PPP_PROFILE=nonpayment

# PPPoE expiry: re-sync past-due lines to MikroTik each tick (5-field cron). Example: every 10 minutes
PPPOE_EXPIRY_CRON=*/10 * * * *
# Logs each tick with { checked, synced, syncFailed }. Set to true to log only when there is work or errors.
# PPPOE_EXPIRY_LOG_QUIET=true
# Per-account line after each successful router sync (noisy)
# PPPOE_SYNC_LOG=1

# Public URL of this React app (payment return URLs)
PUBLIC_APP_URL=http://localhost:5173
# Hotspot walled garden + dashboard “billing access” list: extra HTTPS destinations (comma-separated).
# Use for split deploy (e.g. SPA on Vercel, API on Render): add the API hostname so PPPoE operators
# know what to allow. PPPoE expired profile does not use walled garden — firewall must allow 443.
# WALLED_GARDEN_EXTRA_HOSTS=your-api.onrender.com
# SYNC_WALLED_GARDEN_ON_PING=false

# Shown on Hubtel checkout description / draft UI
MERCHANT_DISPLAY_NAME=QareFi Billing

# In-app draft Hubtel prompt (no live Hubtel call) for renew + hotspot
PAYMENT_DRAFT_CHECKOUT=false
# Legacy alias still accepted:
# PAYMENT_DRAFT_MOMO=false

# Hubtel Online Checkout — https://developers.hubtel.com
# Register callback: https://your-api-domain.com/api/payments/hubtel/callback
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_CALLBACK_URL=https://your-api-domain.com/api/payments/hubtel/callback
# HUBTEL_ALLOWED_CHANNELS=mobileMoney,bankCard
# Skip Hubtel SDK; redirect to local mock page
HUBTEL_MOCK=false

# Allow POST /api/public/payment/mock-complete in production (for testing only)
ALLOW_PAYMENT_SIMULATION=false

# Cron timezone (IANA), e.g. Africa/Accra
CRON_TZ=Africa/Accra

# --- Automatic expiry SMS (PPPoE + remote access; not hotspot vouchers) ---
# Opt-in. Sends one SMS per subscription period when paidUntil is within N days (default 3) and still in the future.
# Uses the org's active MessageTemplate with category expiry_reminder_3d, or a built-in default body.
# Placeholders: {{brand}} {{name}} {{paidUntil}} {{package}} {{secret}} {{service_type}}
EXPIRY_REMINDER_SMS_ENABLED=false
# EXPIRY_REMINDER_DAYS=3
# Daily default 09:00 in CRON_TZ — 5-field cron (min hour dom mon dow)
# EXPIRY_REMINDER_SMS_CRON=0 9 * * *
# Log only when there are sends/failures (or always set false)
# EXPIRY_REMINDER_SMS_LOG_QUIET=true

# Arkesel SMS (broadcasts, payment confirmations, dashboard test send)
# https://sms.arkesel.com — use 233XXXXXXXXX format (we normalize 0XX… automatically)
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
# ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
# Live: ARKESEL_MOCK=false with key + registered sender ID. Mock: logs only, no HTTP.
ARKESEL_MOCK=true
# Parallel outbound requests per broadcast batch (default 5, max 20)
# ARKESEL_SEND_CONCURRENCY=5
# SMS_BRAND_NAME=QareFi
